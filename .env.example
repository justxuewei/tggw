API_AUTH_TOKEN=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=@your_channel_username
WEBHOOK_PATH=/api/messages
GRAFANA_PATH=/api/grafana
GRAFANA_TEMPLATE=vps-network-monitoring
PORT=8080

# Public DNS name that points to this host. Caddy uses it for automatic HTTPS.
DOMAIN=tggw.example.com

# Optional.
TELEGRAM_PARSE_MODE=
TELEGRAM_TIMEOUT_SECONDS=10
MAX_MESSAGE_CHARS=3900
IMAGE=xavierniu/tggw:latest

# Grafana alert de-duplication. Records map an alert stream to the Telegram
# message it owns so repeat notifications edit that message instead of flooding.
RECORD_DB_PATH=/data/tggw-records.db
# Drop records untouched for this many hours (kept under Telegram's 48h edit limit).
RECORD_TTL_HOURS=24
# Stop editing and send a fresh message once the original is this many hours old.
EDIT_WINDOW_HOURS=47
