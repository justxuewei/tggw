API_AUTH_TOKEN=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=@your_channel_username
WEBHOOK_PATH=/api/messages
PORT=8080

# Public DNS name that points to this host. Caddy uses it for automatic HTTPS.
DOMAIN=tggw.example.com

# Optional.
TELEGRAM_PARSE_MODE=
TELEGRAM_TIMEOUT_SECONDS=10
MAX_MESSAGE_CHARS=3900
IMAGE=xavierniu/tggw:latest
